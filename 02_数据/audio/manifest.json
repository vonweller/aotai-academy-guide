  "md5": "06536f879f6f1ed0ee4d1625d3038955"
 },
 {
  "id": "s1_welcome_new_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "欢迎光临鳌台书院，我是你的智能导览员小鳌。这座书院在东莞厚街，是岭南书院文化的代表之一。今天我们走五关，先听书院的故事，再看东莞的手艺。",
  "file": "zh/s1_welcome_new_v2.mp3",
  "bytes": 81258,
  "md5": "0b8e174b2388b3ae7cab7e0fd71c299e"
 },
 {
  "id": "s1_welcome_ok_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "预约访客，欢迎您来到鳌台书院。认出您了，跟好小鳌，我们这就出发。",
  "file": "zh/s1_welcome_ok_v2.mp3",
  "bytes": 39566,
  "md5": "04f18da958f17a8d3d90d77a0b318936"
 },
 {
  "id": "s2_move_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "书院最早建在凤林长生庙旁边。到了清朝乾隆年间，老屋年久失修塌了，族人合力把它迁到菊塘坊菊山脚下，乾隆二十一年落成。",
  "file": "zh/s2_move_v2.mp3",
  "bytes": 86116,
  "md5": "1231b15b8b3d4fc2601d1559a65356cc"
 },
 {
  "id": "s2_origin_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "明朝成化十二年，也就是一四七六年春天，做过宝庆知府的厚街人王恪回到家乡，倡议族人捐资，建起了鳌台书院。",
  "file": "zh/s2_origin_v2.mp3",
  "bytes": 64017,
  "md5": "a51d6be63d478ea6b5b0f8762922a1d1"
 },
 {
  "id": "s2_rebuild_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "今天你看到的书院，是二〇〇八年动工重建、二〇一二年竣工的，占地四千多平方米，保留了正门、中堂、奎星楼三进的格局。",
  "file": "zh/s2_rebuild_v2.mp3",
  "bytes": 67308,
  "md5": "986941a73314d9cc7255c4ea83c6bab5"
 },
 {
  "id": "s3_couplet_mean_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "意思是说，读书贵在顺应时代，通晓古今才算读书人；这片土地本就钟灵毓秀，要在这里培育出栋梁之才。",
  "file": "zh/s3_couplet_mean_v2.mp3",
  "bytes": 64487,
  "md5": "ce2a8524a9050caccfee3436e6ab2f36"
 },
 {
  "id": "s3_couplet_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "柱子上这副对联是：学贵因时，通古今之谓士；地原毓秀，树梁栋以成材。请跟我读一遍。",
  "file": "zh/s3_couplet_v2.mp3",
  "bytes": 55867,
  "md5": "b41bb3f91a04ab0b21955cfc90440d84"
 },
 {
  "id": "s3_gate_couplet_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "书院正门还有一副长联：鳌海澄波看锦鳞而跃浪，彭峰耸翠兆文笔之生花。写的是这里出人才的底气。",
  "file": "zh/s3_gate_couplet_v2.mp3",
  "bytes": 61509,
  "md5": "967b6ed0ef28e3d8a38921307ea7827b"
 },
 {
  "id": "s3_intro_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "我们走进讲堂。古时候，学生就坐在这样的梁柱之间读书、写字、听先生讲学。",
  "file": "zh/s3_intro_v2.mp3",
  "bytes": 42858,
  "md5": "886803e42c9418875eeaf6b4cd8d9c86"
 },
 {
  "id": "s3_three_top_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "状元庄有恭、榜眼冯愿、探花陈伯陶都曾为书院题写匾联，所以它被称为东莞唯一有三甲留墨的书院。",
  "file": "zh/s3_three_top_v2.mp3",
  "bytes": 58688,
  "md5": "bbe31915a0f3fb207d4bce5abd99f0b5"
 },
 {
  "id": "s4_guancao_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "还有莞草编织。咸水草在手里一压一挑，就变成草席、草篮、草帽，这是水乡人家最日常的手艺。",
  "file": "zh/s4_guancao_v2.mp3",
  "bytes": 61039,
  "md5": "74a2d37f707d0b71d21b09abbe58f7c2"
 },
 {
  "id": "s4_workshop_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "这里是非遗工坊。东莞人靠水吃水，一门门老手艺，就是从这样的院子里传下来的。",
  "file": "zh/s4_workshop_v2.mp3",
  "bytes": 47246,
  "md5": "5849231f9eb089360a8abbbd7187655d"
 },
 {
  "id": "s4_xiangyunsha_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "香云纱又叫莨纱，用薯莨汁反复浸染，再用河泥覆盖晾晒，正面乌黑发亮，反面棕红，穿起来沙沙作响。",
  "file": "zh/s4_xiangyunsha_v2.mp3",
  "bytes": 61979,
  "md5": "dd2c847654191e504a915a3e51742e32"
 },
 {
  "id": "s5_bye_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "我是小鳌，谢谢你陪我把这座书院走了一遍。欢迎下次再来，也欢迎再来读一遍那副对联。",
  "file": "zh/s5_bye_v2.mp3",
  "bytes": 46619,
  "md5": "96742fadc134d21e355a1042131cb95e"
 },
 {
  "id": "s5_closing_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "五关走完，从明清的书声，到今天的手艺，鳌台书院一直守在这里，把文脉一代一代传下去。",
  "file": "zh/s5_closing_v2.mp3",
  "bytes": 51948,
  "md5": "f5faa0633be5155ef3b18879d345c8bf"
 },
 {
  "id": "s5_ink_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "古人在这里留下墨迹，你也可以留下自己的心愿。愿你像书院的学子一样，读万卷书，行万里路。",
  "file": "zh/s5_ink_v2.mp3",
  "bytes": 47246,
  "md5": "2af73eaca7799fc94d9bd4c1a3aa4f37"
 },
 {
  "id": "s5_route_v2",
  "lang": "zh",
  "engine": "qwen",
  "voice": "Cherry",
  "text": "离馆前给你一条参观路线：正门牌坊，前院天井和假山，讲堂楹联，东侧非遗工坊，最后到后园六角亭。",
  "file": "zh/s5_route_v2.mp3",
  "bytes": 60098,
  "md5": "99c7da9eb8d0c4aab48679f13b0e9eab"
 }
]